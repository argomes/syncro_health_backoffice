SECRET_KEY=troque-por-uma-chave-segura
# Superuser PostgreSQL — usado APENAS para provisionar databases de clínicas
PROVISIONING_DATABASE_URL=postgres://superuser:senha@host:5432/postgres
DEBUG=False
DATABASE_URL=postgres://user:password@host:5432/syncro_backoffice
ALLOWED_HOSTS=seu-dominio.railway.app
CORS_ALLOWED_ORIGINS=https://seu-frontend.com
# BACFF-007: CORS_ALLOW_ALL_ORIGINS e sempre False, independente de DEBUG.
# Em dev local, defina explicitamente as origens do frontend, ex.:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ASAAS — token configurado em Minha Conta > Configuracoes > Notificacoes no painel ASAAS
ASAAS_WEBHOOK_TOKEN=seu_token_aqui
ASAAS_API_KEY=seu_api_key_aqui
ASAAS_API_URL=https://sandbox.asaas.com/api

# Notion (LEGADO — nao mais usado no fluxo ativo de sync; ver Zoho Desk
# abaixo. Mantido so por referencia historica de tickets antigos.)
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Zoho Desk (integracao ativa de tickets de suporte, BACFF-AVULSA-07)
# client_id/secret + refresh_token gerados via Self Client no
# console.zoho.com (OAuth2 server-to-server, sem login de usuario)
ZOHO_DESK_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_DESK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_DESK_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_DESK_ORG_ID=xxxxxxxxxx
ZOHO_DESK_DEPARTMENT_ID=xxxxxxxxxxxxxxxxxx
ZOHO_DESK_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_DESK_API_BASE_URL=https://desk.zoho.com/api/v1

# Zoho Desk Webhook (BACFF-AVULSA-10) — caminho de VOLTA (Zoho -> Backoffice)
# quando o time responde direto no painel do Zoho Desk. Gerar um valor
# aleatorio (ex.: python -c "import secrets; print(secrets.token_urlsafe(32))")
# e configurar o MESMO valor no header X-Webhook-Secret do webhook criado em
# Setup > Automation > Webhooks no painel Zoho Desk. Ver
# support/webhook_views.py para o passo a passo completo.
ZOHO_DESK_WEBHOOK_SECRET=troque-por-um-token-aleatorio-longo

# Celery (Redis como broker)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Em desenvolvimento, tasks rodam sincronamente sem broker (valor padrao = DEBUG).
# Em producao, defina como False para usar o broker Redis.
CELERY_TASK_ALWAYS_EAGER=False

# Cache compartilhado (Redis) — OBRIGATORIO com DEBUG=False (settings.py falha
# no boot sem isso). Guarda a TemporaryKey da TASK-042 entre workers gunicorn.
CACHE_URL=redis://localhost:6379/1

# Evolution API — alertas via WhatsApp (gateway offline, erro critico, etc.).
# Ver docker-compose.prod.yml para subir o servico junto.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=troque-por-uma-chave-forte

# ZeptoMail (SMTP relay do Zoho) — email transacional, hoje so o fluxo de
# "esqueci minha senha" (SupportUser e ClinicUser, TASK-BO-12). OBRIGATORIO
# com DEBUG=False (settings.py falha no boot sem isso). Token SMTP gerado no
# painel ZeptoMail (Mail Agent > SMTP/API), nao e a senha da conta Zoho.
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=troque-pelo-token-smtp-do-zeptomail
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=naoresponda@seu-dominio-verificado.com.br
