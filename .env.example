SECRET_KEY=troque-por-uma-chave-segura
# Superuser PostgreSQL — usado APENAS para provisionar databases de clínicas
PROVISIONING_DATABASE_URL=postgres://superuser:senha@host:5432/postgres
DEBUG=False
DATABASE_URL=postgres://user:password@host:5432/syncro_backoffice
ALLOWED_HOSTS=seu-dominio.railway.app
CORS_ALLOWED_ORIGINS=https://seu-frontend.com

# ASAAS — token configurado em Minha Conta > Configuracoes > Notificacoes no painel ASAAS
ASAAS_WEBHOOK_TOKEN=seu_token_aqui
ASAAS_API_KEY=seu_api_key_aqui
ASAAS_API_URL=https://sandbox.asaas.com/api

# Notion (integracao de tickets de suporte)
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Celery (Redis como broker)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Em desenvolvimento, tasks rodam sincronamente sem broker (valor padrao = DEBUG).
# Em producao, defina como False para usar o broker Redis.
CELERY_TASK_ALWAYS_EAGER=False

# Cache compartilhado (Redis) — OBRIGATORIO com DEBUG=False (settings.py falha
# no boot sem isso). Guarda a TemporaryKey da TASK-042 entre workers gunicorn.
CACHE_URL=redis://localhost:6379/1

# Evolution API — alertas via WhatsApp (gateway offline, erro critico, etc.).
# Ver docker-compose.prod.yml para subir o servico junto.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=troque-por-uma-chave-forte
